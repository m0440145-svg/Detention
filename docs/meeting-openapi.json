          }
        }
      },
      "post": {
        "summary": "GET own invitation and attendance (managers all) plus aggregate quorum. POST action issue/reset requires reason/version; revoke reason/invitation; mark reason/eligibility/status/verification; respond own answer. Issue returns one-time fragment links with Cache-Control no-store; internal delivery only.",
        "responses": {
          "200": {
