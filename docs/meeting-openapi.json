    "/api/governance-meetings/": {
      "get": {
        "summary": "List authorized records",
        "responses": {
          "200": {
            "description": "Paginated authorized data"
          },
          "403": {
            "description": "No administrative access"
          }
        }
      },
      "post": {
        "summary": "Create persistent record with audit reason",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "number",
                  "name",
                  "committee",
                  "kind",
                  "mode",
                  "starts_at",
                  "ends_at",
                  "rsvp_deadline",
                  "quorum_percent",
                  "quorum_reference",
                  "invitees",
                  "reason"
                ],
                "properties": {
                  "number": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "committee": {
                    "type": "integer"
                  },
                  "kind": {
                    "enum": [
                      "ordinary",
                      "extraordinary",
                      "emergency"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "onsite",
                      "remote",
                      "hybrid"
                    ]
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ends_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "venue": {
                    "type": "string"
                  },
                  "connection_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "rsvp_deadline": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "quorum_percent": {
                    "type": "string",
                    "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                    "description": "0 < value <= 100, no default"
                  },
                  "quorum_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allow_proxy": {
                    "type": "boolean"
                  },
                  "proxy_limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "secrecy": {
                    "enum": [
                      "internal",
                      "secret"
                    ]
                  },
                  "invitees": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "legacy": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid data / duplicate / missing quorum"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
    },
