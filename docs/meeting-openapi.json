          }
        }
      }
    },
    "/api/governance-meetings/{id}/files/": {
      "post": {
        "summary": "Multipart POST file, reason, version, optional item and purpose agenda/proxy. Protected encrypted upload. Returns id, sha256 and authorized download URL.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid input, stale version or lifecycle"
          },
          "403": {
            "description": "Role denied"
          },
          "404": {
            "description": "Outside scoped access"
          }
        }
      }
    },
    "/api/governance-meetings/{id}/proxies/": {
      "post": {
        "summary": "POST principal/delegate eligibility IDs, document ID, valid_until, explicit attendance_allowed/voting_allowed and reason. Revoke action with proxy and reason. Same current roster, no self/observer/chain, proxy limit enforced.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid input, stale version or lifecycle"
          },
          "403": {
            "description": "Role denied"
          },
          "404": {
            "description": "Outside scoped access"
          }
        }
      }
    },
    "/meetings/rsvp/": {
      "get": {
        "security": [],
        "summary": "Public no-account bootstrap. Fragment token is cleared and submitted by CSRF-protected POST. No agenda or participant list.",
        "responses": {
          "200": {
            "description": "No-store, no-referrer form"
          }
        }
      },
      "post": {
        "security": [],
        "summary": "token (43 chars), optional answer confirm/decline/proxy, csrfmiddlewaretoken; capability expires at RSVP deadline and can be revoked.",
        "responses": {
          "200": {
            "description": "Own invitation or generic invalid-link error"
          },
          "403": {
            "description": "CSRF denied"
          },
          "429": {
            "description": "Rate limit"
          }
        }
      }
    },
    "/meetings/files/{id}/": {
      "get": {
        "summary": "Authorized encrypted attachment download, no-store and audit.",
        "responses": {
          "200": {
            "description": "File"
          },
          "404": {
            "description": "Not authorized or unavailable"
          }
        }
      }
    }
