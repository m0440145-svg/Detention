    "/api/governance-meetings/{id}/agenda/": {
      "get": {
        "summary": "GET published revision filtered by secrecy; managers also see draft. POST action save/publish/order/remove requires reason and current meeting version; read requires current agenda revision.",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid input, stale version or lifecycle"
          },
          "403": {
            "description": "Role denied"
          },
          "404": {
            "description": "Outside scoped access"
          }
        }
      },
      "post": {
        "summary": "GET published revision filtered by secrecy; managers also see draft. POST action save/publish/order/remove requires reason and current meeting version; read requires current agenda revision.",
