{
  "openapi": "3.0.3",
  "info": {
    "title": "Meeting governance — phases 1 and 2",
    "version": "0.2.0",
    "description": "Agenda revisions, invitations, frozen eligibility, actual attendance, proxies and internal reminders. Session writes require CSRF. Task approval roles are independent. External sending, votes and minutes remain later phases."
  },
  "security": [
    {
      "sessionCookie": []
    },
    {
      "bearer": []
    }
  ],
