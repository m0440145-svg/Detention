{
  "openapi": "3.0.3",
  "info": {
    "title": "Meeting foundation — phase 1",
    "version": "0.1.0",
    "description": "Member and committee roles do not grant task approval. OTP, RSVP, voting and minutes are later phases. Session writes require CSRF; OAuth requires write scope."
  },
  "security": [
    {
      "sessionCookie": []
    },
    {
      "bearer": []
    }
  ],
  "paths": {
