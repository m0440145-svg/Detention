      "get": {
        "summary": "List authorized records",
        "responses": {
          "200": {
            "description": "Paginated authorized data"
          },
          "403": {
            "description": "No administrative access"
          }
        }
      },
      "post": {
        "summary": "Create persistent record with audit reason",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid data / duplicate / missing quorum"
          },
          "403": {
            "description": "Unauthorized"
          }
        }
      }
