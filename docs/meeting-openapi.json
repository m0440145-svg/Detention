            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Audited state transition",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "reason",
                  "version"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "schedule",
                      "cancel",
                      "archive",
                      "restore"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
