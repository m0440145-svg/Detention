    "/api/communications-master/": {
      "get": {
        "summary": "Operational master data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        }
      }
    },
    "/api/communications-bulk/": {
      "post": {
        "summary": "Atomic reminder or archival within every selected record permission",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mail_ids",
                  "action",
                  "reason"
                ],
                "properties": {
                  "mail_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "integer"
                    }
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "remind",
                      "archive"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    },
    "schemas": {
      "MailInput": {
        "type": "object",
        "required": [
          "kind",
          "subject",
          "party",
          "classification",
          "unit",
          "owner"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "IN",
              "OUT",
              "INT",
              "CIR",
              "DEC",
              "RPL"
            ]
          },
          "subject": {
            "type": "string",
            "maxLength": 250
          },
          "body": {
            "type": "string"
          },
          "party": {
            "type": "integer"
          },
          "classification": {
            "type": "integer"
          },
          "unit": {
            "type": "integer"
          },
          "owner": {
            "type": "integer"
          },
          "external_number": {
            "type": "string",
            "description": "Required for IN"
          },
          "original_date": {
            "type": "string",
            "format": "date",
            "description": "Required for IN"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "important",
              "urgent",
              "critical"
            ]
          },
          "secrecy": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "restricted",
              "secret"
            ]
          },
          "signer": {
            "type": "integer"
          },
          "route": {
            "type": "integer"
          },
          "related": {
            "type": "integer",
            "description": "Required for RPL"
          },
          "no_attachments": {
            "type": "boolean"
          },
          "authorized": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "review",
              "approve",
              "reject",
              "sign",
              "send",
              "receive",
              "start",
              "pause",
              "resume",
              "done",
              "archive",
              "cancel"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
