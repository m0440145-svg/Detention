            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Refer with instruction and mode",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient",
                  "instruction"
                ],
                "properties": {
                  "recipient": {
                    "type": "integer"
                  },
                  "instruction": {
                    "type": "string",
                    "enum": [
                      "view",
                      "reply",
                      "study",
                      "execute",
                      "file"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "parallel",
                      "sequential"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
