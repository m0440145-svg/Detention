{
  "openapi": "3.0.3",
  "info": {
    "title": "Ehsan Correspondence API",
    "version": "1.0.0",
    "description": "Session-authenticated correspondence module. Cookie session and CSRF required for writes. External OAuth2/SSO/signature integrations are not configured."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/communications/": {
      "get": {
        "summary": "List visible mail; kind/status/priority/secrecy/q filters",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        }
      },
      "post": {
        "summary": "Create incoming or outgoing draft",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailInput"
              }
            }
          }
        }
      }
    },
    "/api/communications/{id}/": {
      "get": {
        "summary": "Read visible mail and audit access",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "patch": {
        "summary": "Edit eligible draft/returned/registered mail with reason",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/MailInput"
                  },
                  {
                    "type": "object",
                    "required": [
                      "reason"
                    ],
                    "properties": {
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/communications/{id}/transition/": {
      "post": {
        "summary": "Apply checked lifecycle action",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
