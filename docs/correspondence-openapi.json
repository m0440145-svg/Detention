            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        }
      }
    },
    "/api/communications/{id}/attachments/": {
      "get": {
        "summary": "List names, hashes and protected download URLs",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Upload immutable attachment version",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
            "description": "Permission or CSRF denied"
          },
          "404": {
            "description": "Record not visible or missing"
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "reason"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/communications/{id}/referrals/": {
      "get": {
        "summary": "List referrals; suppress task IDs outside task scope",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid fields/state/reason"
          },
          "403": {
