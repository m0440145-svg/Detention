                ],
                "properties": {
                  "referral": {
                    "type": "integer"
                  },
                  "due_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/communications/{id}/extend-due/": {
